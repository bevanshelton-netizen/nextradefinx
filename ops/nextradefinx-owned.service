[Unit]
Description=NexTradeFinX IZAKHONO-owned production runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/izakhono-runtime/nextradefinx
Environment=NODE_ENV=production
Environment=NEXTRADE_PORT=3000
ExecStart=/usr/bin/npm start -- -p 3000
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
